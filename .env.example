# Copy this file to .env and fill in the values you need. Nothing here has
# a working default baked into the code — see README.md for how to obtain
# each credential.

# --- Required -----------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# --- Server ---------------------------------------------------------------
PORT=5000
FLASK_DEBUG=false
# Binding to 0.0.0.0 exposes the server to your whole network. Only set
# this true if you understand that tradeoff (see README).
JARVIS_ALLOW_LAN=false
# Where JARVIS sandboxes file/script work. Defaults to ~/JarvisWorkspace.
# JARVIS_WORKSPACE=

# --- Google Calendar + Gmail -----------------------------------------------
# https://console.cloud.google.com/ — enable the Calendar API and Gmail
# API, create an OAuth client of type "Desktop app". Run
# `python google_login.py` once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Outlook/365 Calendar + Mail --------------------------------
# https://portal.azure.com/ — App registrations -> New registration, add a
# "Mobile and desktop applications" platform with http://localhost as the
# redirect URI, enable "Allow public client flows", and grant delegated
# Graph permissions: Calendars.ReadWrite, Mail.Read, Mail.Send, User.Read.
# Run `python microsoft_login.py` once.
MS_CLIENT_ID=
# "common" allows both personal and work/school Microsoft accounts. Set
# this to your tenant ID to restrict sign-in to one organization.
MS_TENANT_ID=common

# --- Daily briefing --------------------------------------------------------
# Proactive once-a-day spoken agenda, pushed over /api/stream. Requires at
# least one of Google/Microsoft above to be configured; otherwise it's
# skipped automatically even if enabled here.
JARVIS_DAILY_BRIEFING=true
JARVIS_BRIEFING_HOUR=8
JARVIS_BRIEFING_MINUTE=0
